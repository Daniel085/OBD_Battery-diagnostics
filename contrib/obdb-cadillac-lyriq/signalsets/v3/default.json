      "freq": 1,
      "signals": [
        {
          "id": "LYRIQ_HVBAT_A",
          "path": "Battery",
          "fmt": {
            "len": 16,
            "sign": true,
            "max": 1000,
            "min": -1000,
            "div": 20,
            "unit": "amps"
          },
          "name": "HV battery current",
          "description": "Signed pack current from the drive-motor/power-electronics controller (negative = charging). Confirmed -22.75 A at a steady 9.22 kW AC charge and +0.9 A accessory draw in Ready. Same register family as Chevy Bolt 7E1 222414.",
          "suggestedMetric": "tractionBatteryCurrent"
        }
      ]
    },
    {
      "hdr": "DA17",
      "cmd": {
        "22": "2429"
      },
      "freq": 60,
      "signals": [
        {
          "id": "LYRIQ_HVBAT_NOMINAL_V",
          "path": "Battery",
          "fmt": {
            "len": 16,
            "max": 1023,
            "div": 64,
            "unit": "volts"
          },
          "name": "HV battery nominal voltage",
          "description": "Constant rated (nominal) pack voltage, 352.1 V on a 2025 LYRIQ - identical while charging at 70% SOC and at rest at 80% SOC, so it is not a live measurement. Duplicates at 2428/242D/2434/2489."
        }
      ]
    },
    {
